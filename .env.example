# ==============================================================
# SPM STORE - SISTEMA FISCAL & AUDITORIA DE NFs
# Arquivo de Variáveis de Ambiente (.env)
# ==============================================================

# Ambiente de Execução (development ou production)
NODE_ENV=production

# Porta do Servidor Node.js
PORT=3000

# URL Oficial do seu Domínio (usado para links, webhooks e CORS)
# Exemplo: https://spmstore.spmoficial.com.br
APP_URL=https://spmstore.spmoficial.com.br

# Chave Secreta para Assinatura dos Tokens JWT (Gere uma chave longa e segura)
JWT_SECRET=spm_store_chave_secreta_jwt_producao_2026_fiscal_elite

# ==============================================================
# BANCO DE DADOS MYSQL
# ==============================================================
# Para XAMPP Local: DB_HOST=localhost, DB_PORT=3306, DB_USER=root, DB_PASSWORD=
# Para Docker VPS:  DB_HOST=mysql,     DB_PORT=3306, DB_USER=root, DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spm_fiscal

# ==============================================================
# INTELIGÊNCIA ARTIFICIAL (GEMINI API)
# ==============================================================
# Chave da API Google Gemini para OCR e extração inteligente de DANFEs
GEMINI_API_KEY=

# ==============================================================
# GOOGLE DRIVE OFICIAL EM NUVEM (Pasta Web de NFs)
# ==============================================================
GDRIVE_ONLINE_FOLDER_ID=1cqhLdzayHMwzLxdi60rucCEqvK0tfHOz
GDRIVE_ONLINE_FOLDER_URL=https://drive.google.com/drive/folders/1cqhLdzayHMwzLxdi60rucCEqvK0tfHOz
GDRIVE_ONLINE_AUTO_POLL=true
GDRIVE_ONLINE_POLL_INTERVAL_SEC=30

# ==============================================================
# GOOGLE DRIVE PARA DESKTOP (Monitoramento de Pasta Local)
# ==============================================================
GDRIVE_DESKTOP_PATH=I:\Meu Drive\SPM Store\SPM Verniz Elite\SPM Verniz\Verniz Elite SPM Pedidos\Notas_Fiscais
GDRIVE_AUTO_SYNC=true

# ==============================================================
# CLOUDFLARE TUNNEL (Opcional - para expor sem abrir portas)
# ==============================================================
CLOUDFLARE_TUNNEL_TOKEN=
